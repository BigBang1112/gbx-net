CPlugSolid 0x09005000
- inherits: CPlug

0x000 [TM10, TMPU, TMSX, TMNESWC, TMU, VSK5, TMF, MP3, TMT, MP4, TM2020] // PlugIdCounter
  int PlugIdCounter = 1

0x006 // legacy mass and inertia
  float
  float
  float Mass = 1
  vec3 CenterOfMass
  mat3 InverseInertiaMatrix = (0.23873241f, 0, 0, 0, 0.23873241f, 0, 0, 0, 0.23873241f)

0x007 [TM10, TMPU, TMSX]
  bool

0x00B // legacy physical flags
  bool
  bool
  bool
  bool
  bool
  bool
  float
  int

0x00C [TM10, TMSX, TMNESWC] // legacy physical flags
  bool
  bool
  bool
  bool
  bool
  bool
  bool
  bool
  bool
  bool
  float
  int
  float
  float
  float
  float
  int
  int

0x00D [TM10, TMPU, TMSX, TMNESWC] // model and tree
  bool UseModel = true
  bool HasModel (local, write: "Model is not null")
  if HasModel
    CPlugSolid Model
  if !HasModel
    CPlugTree Tree

0x00E [TM10, TMPU, TMSX, TMNESWC, TMU, VSK5, TMF] // mass, inertia, and friction
  float Mass = 1
  vec3 CenterOfMass
  mat3 InverseInertiaMatrix = (0.23873241f, 0, 0, 0, 0.23873241f, 0, 0, 0, 0.23873241f)
  float LinearFluidFriction = 0.1f
  float AngularFluidFriction = 0.3f
  float MaxDistPerStep = 0.3f

0x00F [TM10, TMSX, TMNESWC] // legacy physical parameters
  float
  float

0x010 [TMSX, TMNESWC, TMU, VSK5, TMF, MP3, TMT, MP4, TM2020] // legacy vehicle environment
  CMwNod // CSceneVehicleEnvironment

0x011 [TMU, VSK5, TMF, MP3, TMT, MP4, TM2020] // model and tree
  bool UseModel = true
  bool HasModel (local, write: "Model is not null")
  if HasModel
    bool? ModelIsExternal (write: "ModelIsExternal ?? (n.References.Model.Kind == NodeRefKind.ExternalFile)")
    CPlugSolid Model
  if !HasModel
    CPlugTree Tree

0x012 [TMU, VSK5, TMF] // TileCountU
  byte TileCountU

0x017 [MP3.v3, TMT.v3, MP4.v3, TM2020.v3] // SolidPreLightGen
  version
  v3+
    bool HasPreLightGen
    if HasPreLightGen
      PreLightGen SolidPreLightGen
  v2-
    byte TileCountU
    float MeterByUv = -1
    bool IsComputed
    rect UvBBox = (float.MaxValue, float.MaxValue, float.MinValue, float.MinValue)
    rect UvBBoxSH = (float.MaxValue, float.MaxValue, float.MinValue, float.MinValue)
    int2 SpriteCount
    v1+
      boxaligned[] ProbeBoxes
  v2+
    filetime? FileWriteTime

0x019 [MP3.v0, TMT.v1, MP4.v3, TM2020.v5] // sounds, particles, and path
  version
  CPlugSound[] Sounds (deprec)
  CPlugParticleEmitterModel[] ParticleEmitterModels (deprec)
  LocatedInstance[] SoundInstances
  LocatedInstance[] ParticleInstances
  v1+
    int
    v2+
      id[]
      iso4[]
      v3+
        string
        v4+
          int
          v5+
            CPlugPath Path

0x01A (skippable) [MP4.v4, TM2020.v4] // LOD normal maps
  version
  v2-
    data LodNormalMapTga
    v1=
      bool HasVeryLQDiffuse (write: "VeryLQDiffuse != null")
      if HasVeryLQDiffuse
        FileImageData VeryLQDiffuse
  v4+
    LodNormalMap SolidLodNormalMap

archive PreLightGen
  version
  int TileCountU // PreLightGenTileCountU, zero when the mapper is unavailable
  float MeterByUv = -1
  bool IsComputed // Mapper computation has been attempted
  rect UvBBox = (float.MaxValue, float.MaxValue, float.MinValue, float.MinValue)
  rect UvBBoxSH = (float.MaxValue, float.MaxValue, float.MinValue, float.MinValue)
  int2 SpriteCount
  boxaligned[] ProbeBoxes // Probe centers and half extents
  v1+ (archive)
    UvGroup[] UvGroups

archive UvGroup
  float MeterByUv
  rect UvBBox

archive LocatedInstance
  int ModelIndex
  iso4 Loc = Iso4.Identity

archive LodNormalMap
  version = 2
  CPlugVisualIndexedTriangles Visual
  FileImage Normal
  v1+ (archive)
    FileImage Diffuse

archive FileImage
  bool IsNull = true (write: "Data == null")
  if !IsNull
    FileImageData Data

archive FileImageData
  int3 Size
  datauint Flags
  data[PixelDataLength] Pixels
