CPlugScriptWithSettings 0x09083000

0x000 [MP4, TM2020] // script and settings
  CPlugFileTextScript* Script
  int SettingCount (local, write: "n.Settings?.Length ?? 0")
  int SettingsVersion
  if SettingsVersion >= 1
    byte SettingTypeVersion = 4
    if SettingCount > 0
      throw // typed settings are not supported yet
  CScriptSetting[SettingCount] Settings
