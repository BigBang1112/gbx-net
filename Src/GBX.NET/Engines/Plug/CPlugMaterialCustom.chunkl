CPlugMaterialCustom 0x0903A000
- inherits: CPlug

0x004 [TMSX, TMNESWC, TMU, VSK5, TMF, MP3, TMT, MP4, TM2020] // FuncShaders
  CFuncShader?[] FuncShaders

0x006 [TMSX, TMNESWC, TMU, VSK5, TMF, MP3, TMT]
  Bitmap[] Bitmaps

0x009 (skippable) [TMSX] // legacy shader flags and requirements
  datauint<ulong> Flags
  dataulong ShaderRequirements
  if (Flags & 1) != 0
    short

0x00A [TMSX, TMNESWC, TMU, VSK5, TMF, MP3, TMT, MP4, TM2020] // GPU constants
  GpuFx[] GpuFxColors
  GpuFx[] GpuFxReals

0x00B [TMNESWC, TMU, VSK5]
  datauint<ulong> Flags
  dataulong ShaderRequirements
  if (Flags & 1) != 0
    VisibleFilterData VisibleFilter

0x00C [TMU, VSK5, TMF, MP3, TMT, MP4, TM2020]
  BitmapSkip[] BitmapSkips

0x00D [TMF, MP3, TMT, MP4]
  dataulong Flags = 0x7F0001FC0000 [TM2020 = 0x7F8001FC0000]
  dataulong ShaderRequirements
  if (Flags & 1) != 0
    VisibleFilterData VisibleFilter

0x00E (skippable) // legacy VisibleMaxDist
  float VisibleMaxDist = -1

0x00F (skippable) [MP3.v1, TMT.v1, MP4.v2, TM2020.v2]
  version
  float VisibleMaxDist
  float VisibleMinScreenHeight = -1
  v1+
    float LightThroughRatioBounce
    v2+
      DefineNat[] DefineNats

0x010 [MP3, TMT]
  CPlugBitmap BitmapShadowOpacity

0x011 (skippable) [MP3, TMT, MP4, TM2020] // VSplitIndexSemantic
  int VSplitIndexSemantic = -1

0x012 [MP4, TM2020]
  CPlugBitmap BitmapShadowOpacity

0x013 [MP4, TM2020]
  version
  Bitmap[] Bitmaps (version: 1)

0x014 [MP4.v0, TM2020.v1] // ConstantBuffers
  version
  CBuffer[] ConstantBuffers

0x015 [MP4.v1, TM2020.v2]
  version
  v1+
    int IndexCountPerVertex
  if IndexCountPerVertex == 0
    string SubTextureNamePxz
    string SubTextureNamePy
    v2+
      string SubTextureNamePyX2
      string SubTextureNamePyH2

0x016 [TM2020.v2]
  version
  dataulong Flags
  dataulong ShaderRequirements
  v1+
    int
  if (Flags & 1) != 0
    VisibleFilterData VisibleFilter

archive Bitmap
  id LayerName
  int
  CMwNod BitmapOrImage
  v1+
    int TexAddressU = 4 // preserves the shader's address mode
    int TexAddressV = 4

archive GpuFx

archive BitmapSkip
  id LayerName
  bool IsSkipped

archive DefineNat
  id Name
  int Value

archive CBuffer
  int<EGpuStage> Stage = EGpuStage.Unknown
  int ByteSize (write: "v >= 1 && IsDataAbsent ? ByteSize : Data?.Length ?? 0")
  v1+
    bool IsDataAbsent // retains ByteSize without serializing data
  if v == 0 || !IsDataAbsent
    byte[ByteSize] Data

archive VisibleFilterData
  short BitMask
  short BitValue // replaces shader visibility bits selected by BitMask

enum EGpuStage
  Vertex = 0
  Pixel = 1
  Domain = 2
  Geometry = 3
  Hull = 4
  Compute = 8
  Unknown = 9
