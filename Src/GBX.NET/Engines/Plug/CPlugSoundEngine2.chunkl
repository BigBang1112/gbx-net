0x001 [TMT.v3, MP4.v3, TM2020.v5]
  version
  float RpmMaxFromEngine = 10000f
  v4-
    CFuncKeysReal Volume_Speed (direct)
    CFuncKeysReal Volume_Distance (direct)
    CFuncKeysReal Volume_Rpm (direct)
    CFuncKeysReal Volume_Throttle (direct)
  v5+ // curves stored inline
    PlugCurve
    PlugCurve
    PlugCurve
    PlugCurve
  v1+
    PerspectiveVolume[3] PerspectiveVolumes (version: Version)
    bool Loops_RpmClamp = true
    bool Loops_UseVolumeCorrection
  v2+
    float RpmGamma = 1f
  v3..4
    CFuncKeysReal Volume_Gear (direct)
    CFuncKeysReal RpmFactor_Gear (direct)
  v5+
    PlugCurve
    PlugCurve
  v4+
    LowPassFilter[3] LowPassFilters

0x002 [TMT.v4, MP4.v4, TM2020.v6]
  version
  AudioMotor[3] AudioMotors (version: Version)
  v5-
    CFuncKeysReal AudioMotors_PitchRandomize_Rpm (direct)
    CFuncKeysReal AudioMotors_PitchRandomize_Throttle (direct)
