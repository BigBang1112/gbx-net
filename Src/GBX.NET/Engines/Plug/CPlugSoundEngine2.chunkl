0x003 [TMT.v4, MP4.v4, TM2020.v4]
  version
  SubEmitter[3] SubEmitters (version: Version)
  v1+
    float Mix_FrontBackSpread = 1f
    v2-
      float[4]
    v3+
      float MixFront = 0.85f
      float MixBack = 0.35f

archive PerspectiveVolume
  v4-
    CFuncKeysReal Rpm (direct)
    CFuncKeysReal Throttle (direct)
  v5+ // curves stored inline
    PlugCurve
    PlugCurve

archive AudioMotor
  CMwNod Throttle // CPlugFileAudioMotors
  CMwNod Release // CPlugFileAudioMotors
  v2+
    CPlugFileSnd IdleLoop
    CPlugFileSnd LimiterLoop
    v4=
      float LowPassCutoffRatio = 1f // moved to LowPassFilters in 0x001 v4+
    v3+
      float IdleVolume = 1f // linear, shown in dB as AudioMotors_IdleVolumedB
      float LimiterVolume = 1f // linear, shown in dB as AudioMotors_LimiterVolumedB

archive SubEmitter
  float Volume = 1f
  float RelativeSize = 1f
  vec3 RelativePosition
  vec3 RelativeDirection
  v2+
    float ConeAttenuation
    float ConeAngle

archive LowPassFilter
  float CutoffRatio = 1f
  bool Enabled // set by v4 0x002 when the cutoff ratio is below 0.9
