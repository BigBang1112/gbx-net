archive PipelineGpu
  bool HasExternalFile (write: "References.FileGpu.Kind == NodeRefKind.ExternalFile")
  CPlugFileGPU FileGpu
  if FileGpu != null
    GpuLoadFx[] GpuLoadFxs = empty (version: 0)
    vec4[] FxValues = empty

archive GpuLoadFx
  id Name
  int U02 // Three-bit value kind.
  int RegistersPerElement // Four-component registers per array element.
  int ElementCount // Number of elements contributing registers.
  int ValueIndex // First four-component constant in FxValues.

archive Sampler
  CPlugBitmap Bitmap
  id Name
