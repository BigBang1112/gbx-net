CPlugSoundMulti 0x09064000
- inherits: CPlugSound

0x000 [TMSX, TMNESWC, TMU, VSK5, TMF]
  CMwNod AdditionalSounds
  bool IsForceRandom (local, write: "n.InputMapping == ESoundInputMapping.ForceRandom")
  if IsForceRandom
    InputMapping = ESoundInputMapping.ForceRandom

0x001 [MP3, TMT, MP4, TM2020]
  CMwNod[] AdditionalSounds2 (deprec)
  bool IsForceRandom (local, write: "n.InputMapping == ESoundInputMapping.ForceRandom")
  if IsForceRandom
    InputMapping = ESoundInputMapping.ForceRandom

0x002 [MP3.v3, TMT.v3, MP4.v3, TM2020.v3]
  version
  float PitchVariancePos
  float VolumeVariance
  v1+
    bool AvoidDuplicates
    v2+
      bool AlternateParity
      v3+
        float PitchVarianceNeg

0x003 [MP3.v0, TMT.v2, MP4.v2, TM2020.v2]
  version
  bool IsDistance (local, write: "n.InputMapping == ESoundInputMapping.Distance")
  if IsDistance
    InputMapping = ESoundInputMapping.Distance
  vec3[] PreferedDistances
  v1+
    CFuncKeysReal VolumeFromInput
    v2+
      int<ESoundInputMapping> InputMapping

enum ESoundInputMapping
  Direct
  ForceRandom
  Distance
  Scale
