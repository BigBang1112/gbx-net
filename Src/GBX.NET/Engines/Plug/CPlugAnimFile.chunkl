archive GraphNode (contextual)
  int Type = -1
  if Type == 13
    GraphRoot Group (version: v)
  else if Type == 7 || Type == 10 || Type == 11 || Type == 14 || Type == 16 || Type == 17 || Type == 19 || Type == 24 || Type == 26
    GraphNodeBase Base (version: n.VariableVersion)
  else if Type == 2
    GraphNodeBase Base (version: n.VariableVersion)
    GraphReference Reference (version: v)
  else if Type == 1
    GraphNodeBase Base (version: n.VariableVersion)
    GraphAnimation Animation (version: v)
  else if Type == 8
    GraphNodeBase Base (version: n.VariableVersion)
    GraphEvent Event (version: v)
  else if Type == 3
    GraphNodeBase Base (version: n.VariableVersion)
    GraphAnimation3 Animation3 (version: v)
  else if Type == 9
    GraphNodeBase Base (version: n.VariableVersion)
    GraphWeights Weights (version: v)
  else if Type == 20
    GraphNodeBase Base (version: n.VariableVersion)
    GraphExpression Expression (version: v)
  else if Type == 0
    GraphNodeBase Base (version: n.VariableVersion)
    GraphInput Input (version: v)
  else if Type == 4
    GraphNodeBase Base (version: n.VariableVersion)
    GraphBlend Blend (version: v)
  else if Type == 5
    GraphNodeBase Base (version: n.VariableVersion)
    GraphValue Value (version: v)
  else if Type == 6 || Type == 22 || Type == 34
    GraphNodeBase Base (version: n.VariableVersion)
    id U01
    if Type == 6
      id U02
      id U03
  else if Type == 18
    GraphNodeBase Base (version: n.VariableVersion)
    GraphVariable Variable (version: v)
  else if Type == 21
    GraphNodeBase Base (version: n.VariableVersion)
    GraphIds Ids (version: v)
  else if Type == 23
    GraphNodeBase Base (version: n.VariableVersion)
    GraphCondition Condition (version: v)
  else if Type == 25
    GraphNodeBase Base (version: n.VariableVersion)
    GraphStrings Text (version: v)
  else if Type == 15
    GraphNodeBase Base (version: n.VariableVersion)
    GraphAction Action
  else if Type == 28
    GraphNodeBase Base (version: n.VariableVersion)
    id U01
    v52+
      string U04
  else if Type == 12
    GraphNodeBase Base (version: n.VariableVersion)
    GraphStateMachine StateMachine (version: v)
  else if Type != -1
    throw (type: NotSupportedException, message: Unsupported animation graph node type)

