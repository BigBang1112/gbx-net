CPlugDecalModel 0x090A7000
- inherits: CPlug

property bool IsObsolete
  get = (Flags & 1) != 0
  set
    if value
      Flags = Flags | 1
    else
      Flags = Flags & 0xFFFFFFFE

0x000 // legacy textures
  CPlugBitmap DiffuseA
  CPlugBitmap Normal

0x001 // Solid
  CPlugSolid Solid

0x002 [MP3.v4, TMT.v5, MP4.v6, TM2020.v6] // textures and projection limits
  version
  v4-
    CPlugBitmap DiffuseA
    CPlugBitmap Normal
  v1+
    float TexelByMeter = 256
  v2+
    bool FadeNormalAndZ = true
  v3+
    float MaxAngleNCos = 0.087155804f
  v4=
    CPlugBitmap Specular
  v5+
    string DiffuseARef = ""
    if DiffuseARef == null || DiffuseARef == ""
      CPlugBitmap DiffuseA
    string NormalRef = ""
    if NormalRef == null || NormalRef == ""
      CPlugBitmap Normal
    string SpecularRef = ""
    if SpecularRef == null || SpecularRef == ""
      CPlugBitmap Specular
  v6+
    string RoughnessRef = ""
    if RoughnessRef == null || RoughnessRef == ""
      CPlugBitmap Roughness

0x003 [MP3, TMT, MP4, TM2020] // Icon
  CPlugBitmap Icon

0x004 [MP3.v3, TMT.v7, MP4.v8, TM2020.v8] // solid, sprite, SVG, and macro decals
  version
  CPlugSolid Solid
  bool RandomInstances = true
  v2+
    float MaxAngleN3dCos = 0.49999997f
  v3+
    CPlugBitmap Sprite3dBitmap
    id Sprite3dGroupId
  v4+
    string SvgRef = ""
    if SvgRef == null || SvgRef == ""
      CMwNod Svg
  v5+
    float SvgSize = 1
  v6+
    float SvgAlpha = 1
  v7+
    int MinAngleN3d
  v8+
    CPlugDecalModel[] DecalModels = empty (deprec)
    MacroDecalSet[] MacroDecalSets = empty

0x005 // ImpactSize
  version
  float ImpactSize = 0.1f

0x006 [MP3, TMT, MP4, TM2020] // flags
  version
  uint Flags

archive MacroDecalSet
  id Id
  box Bounds = DefaultBounds
  MacroDecal3d[] Decals = empty

archive MacroDecal3d
  int DecalModelIndex
  id SpriteGroupId
  float Scale
  vec2 Position // Editing-plane X and Z coordinates
