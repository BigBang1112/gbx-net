CPlugMaterialUserInst 0x090FD000

0x000 [MP3.v4, TMT.v6, MP4.v9, TM2020.v11] // material and shader parameters
  version
  v11+
    boolbyte IsUsingGameMaterial
  id Name
  id Model
  string BaseTexture
  byte<CPlugSurface.MaterialId> SurfacePhysicId
  v10+
    byte<CPlugSurface.GameplayId> SurfaceGameplayId
  v1+
    if IsUsingGameMaterial
      string Link
    if !IsUsingGameMaterial
      v9+
        v10-
          string Link
        v11+
          id Link
      v8-
        id Link
    v2+
      Cst[] Csts
      int[] CstValues // raw 32-bit values shared by the shader constants
      v3+
        UvAnim[] UvAnims
        v4+
          id[] VisibleIds
          v6+
            UserTexture[] UserTextures
            v7+
              id HidingGroup

0x001 [MP4.v5, TM2020.v5] // texture atlas and tiling
  version
  CPlugBitmapAtlas TextureAtlas
  v1=
    bool
    float TextureSizeInMeters = 1
  v2=
    int<ETexAddress> TilingU
    int<ETexAddress> TilingV
    float TextureSizeInMeters
    float
  v3+
    int<ETexAddress> TilingU
    int<ETexAddress> TilingV
    float TextureSizeInMeters
    v4+
      int
      v5+
        bool IsNatural

0x002 [TM2020]
  version
  int

enum ETexAddress
  Wrap
  Mirror
  Clamp
  Border

archive Cst
  id Name
  id Type
  int ValueCount // number of 32-bit words in CstValues

archive UvAnim
  id Layer
  id Type
  float Period
  ulong Data // ScaleU/ScaleV or Count/CountX/CountY, depending on Type
  v5+
    id InputVal

archive UserTexture
  int Layer
  string Texture
