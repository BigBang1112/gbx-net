CPlugFileGen 0x0902F000
- inherits: CPlugFileImg

// The high bit distinguishes the versioned archive from the legacy generator-kind prefix.
archive
  v0+
    int GenKind = 51 [TM2020 = 54]
  int[] IntParams
  vec4[] ColorParams
  v0+
    float[] RealParams
  v3+
    string Script
  v4+
    CFuncKeysReal[] Functions (direct)
  v6+
    CPlugFileImg[] InputImages
  if GenKind == 9
    data[PixelDataLength] PixelData

