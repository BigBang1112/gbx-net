CPlugWeather 0x0917E000
- inherits: CFunc

property bool FogByVertex
  get = (FogFlags & 1) != 0
  set
    if value
      FogFlags = FogFlags | 1
    else
      FogFlags = FogFlags & 0xFFFFFFFE

