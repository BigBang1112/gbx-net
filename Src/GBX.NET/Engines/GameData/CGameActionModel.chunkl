archive ActionScriptEffect (contextual) // version is the action chunk version
  int Type
  if Type == 0
    AnimScriptEffect AnimEffect
  else if Type == 3
    BuffScriptEffect BuffEffect
  else if v < 32
    if Type == 5
      EffectScriptEffect EffectEffect (version: n.ActionScriptEffectVersion)
    else
      ProjScriptEffect ProjEffect
  else if Type == 1 || Type == 2 || Type == 4 && v < 35
    ProjScriptEffect ProjEffect
  else if Type == 4
    ScriptEffect4 Effect4 (version: n.ActionScriptEffectVersion)
  else if Type == 5
    int[9] LegacyEffectValues // discarded

