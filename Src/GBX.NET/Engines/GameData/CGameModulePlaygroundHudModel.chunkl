- inherits: CGameModuleModelCommon

0x000 (skippable) // manialink and module slots
  version = 9
  CPlugFileText Manialink
  Slot Inventory
  Slot Store
  Slot ScoresTable
  v2+
    Slot Chrono
  v3+
    Slot SpeedMeter
  v4+
    Slot PlayerState
  v5+
    Slot TeamState
  v9+
    Slot Altimeter
    Slot Throttle
