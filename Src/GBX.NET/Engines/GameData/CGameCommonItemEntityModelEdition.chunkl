CGameCommonItemEntityModelEdition 0x2E026000

0x000 [TM2020.v8]
  version
  int<EItemType> ItemType
  CPlugCrystal MeshCrystal (external)
  string SolidRef
  if SolidRef == null || SolidRef.Length == 0
    CPlugSolid Solid (external)
  ImageRef[] Images
  SpriteParam[] SpriteParams
  CPlugParticleEmitterModel DestroyParticleModel (external)
  CPlugAnimLocSimple LocAnim (external)
  LightBallStateSimple[] LightBallStates // Native CFixedDynArray capacity is one.
  string ParticleModelAliveRef
  if ParticleModelAliveRef != null && ParticleModelAliveRef.Length > 0
    vec3 ParticleModelAlivePos
  string SmashParticleRef
  if SmashParticleRef != null && SmashParticleRef.Length > 0
    id
  string SoundRefSpawn
  string SoundRefUnspawn
  string SoundRefGrab
  string SoundRefSmashed
  string SoundRefPermanent
  iso4 SoundLocPermanent = Iso4.Identity
  v4-
    if Version >= 3 || ItemType == EItemType.Ornament || ItemType == EItemType.Spot
      bool UseMeshAsMoveShape = true
      if !UseMeshAsMoveShape
        CPlugCrystal CustomMoveShapeCrystal (external)
  v3+
    if ItemType == EItemType.PickUp
      float Mass = 1
  bool UseMeshAsHitShape = true
  if !UseMeshAsHitShape
    CPlugCrystal CustomHitShapeCrystal (external)
  if ItemType == EItemType.PickUp
    bool UseMeshAsTriggerShape = true
    if !UseMeshAsTriggerShape
      CPlugCrystal CustomTriggerShapeCrystal (external)
    CGameActionModel PickupActionModel (external)
  if ItemType == EItemType.Spot
    CGameActionModel[] TriggeredActions (external)
    int TriggerActionVersion = 5
    CPlugTriggerAction[] Triggers (version: n.TriggerActionVersion)
  bool HasDynaPointModel (local, write: "n.DynaPointModel is not null")
  if HasDynaPointModel
    CPlugDynaPointModel DynaPointModel
  int<CGameObjectPhyModel.EProgram> Program
  v3-
    iso4 SpawnLoc = Iso4.Identity // Removed from the payload in version 4.
  v1+
    string InventoryName
    string InventoryDescription
    int InventoryItemClass
    int InventoryOccupation = 1000
  v1-
    CPlugSolid2Model (external) // Deprecated mesh reference.
  v6..7
    CMwNod (external) // Deprecated reference.
  v7+
    if ItemType == EItemType.PickUp
      int

