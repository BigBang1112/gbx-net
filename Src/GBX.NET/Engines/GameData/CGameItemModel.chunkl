0x019 [MP3.v4, TMT.v7, MP4.v12, TM2020.v16] // model
  version
  if ItemType == EItemType.Ornament || ItemType == EItemType.PickUp || ItemType == EItemType.Spot
    v8-
      CMwNod PhyModelCustom
      CMwNod VisModelCustom
  else if ItemType == EItemType.Vehicle
    v9-
      CMwNod PhyModelCustom
      CMwNod VisModelCustom
  else if ItemType != EItemType.Block
    v11-
      CMwNod PhyModelCustom
      CMwNod VisModelCustom
  v1=
    CMwNod VisualModel
  v3+
    id DefaultWeaponName
  v4+
    if n.References.PhyModelCustom.Kind != NodeRefKind.None
      int PhyModelCustomIndex (local, write: -1)
    else
      CMwNod PhyModelCustom
  v5+
    if n.References.VisModelCustom.Kind != NodeRefKind.None
      int VisModelCustomIndex (local, write: -1)
    else
      CMwNod VisModelCustom
  v6+
    CGameActionModel[] Actions (direct)
  v7+
    int<EDefaultCam> DefaultCam
  v8+
    CMwNod EntityModelEdition // CGameCommonItemEntityModelEdition, CGameBlockItem, CPlugVegetTreeModel
    if n.References.EntityModelEdition.Kind == NodeRefKind.None
      if ItemType == EItemType.Block
        throw (type: Exception, message: EntityModel cannot exist for Block)
      CMwNod EntityModel
  v13+
    CPlugVFXFile VFX
  v15+
    CPlugGameSkinAndFolder MaterialModifier
  v16+
    CMwNod

