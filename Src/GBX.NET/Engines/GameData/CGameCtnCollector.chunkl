0x010 [MP3.v2, TMT.v2, MP4.v2, TM2020.v4]
  version
  CPlugFileZip DefaultSkin (external)
  v1+
    string SkinDirectory
  v2+
    if SkinDirectory == null || SkinDirectory == ""
      CMwNod (external) // CPlugFileZip
  if rw.Reader != null && !rw.Reader.IsRelease || rw.Writer != null && !rw.Writer.IsRelease
    v3+
      string // folder path, archived with DoFolderAsString
    v4+
      CMwNod ModelKitDb (external)
      CMwNod ModelKitDbRelease (external)

