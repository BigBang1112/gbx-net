GxLightBall 0x04002000
- inherits: GxLightPoint

0x000
  float Radius = 10
  float Attenuation1 = -1 // Legacy linear coefficient, scaled by Radius when loaded
  float Attenuation2 = -1 // Legacy quadratic coefficient, scaled by Radius squared when loaded
  if Attenuation1 > -0.5f
    AttHTnLR = Radius * Attenuation1
    AttHTnLR2 = Attenuation2 * Radius * Radius

0x001
  float Radius
  float Attenuation1
  float Attenuation2
  float EmittingRadius
  if Attenuation1 > -0.5f
    AttHTnLR = Radius * Attenuation1
    AttHTnLR2 = Attenuation2 * Radius * Radius

0x002 [TM10, TMPU]
  float Radius
  float Attenuation1
  float Attenuation2
  float EmittingRadius
  vec3 AmbientRGB
  RadiusSpecular = Radius
  if Attenuation1 > -0.5f
    AttHTnLR = Radius * Attenuation1
    AttHTnLR2 = Attenuation2 * Radius * Radius

0x003
  float Radius
  float RadiusSpecular = 10
  float EmittingRadius
  float Attenuation1
  float Attenuation2
  vec3 AmbientRGB
  if RadiusSpecular - Radius > 0.00001f || RadiusSpecular - Radius < -0.00001f // Compare against 1, |Radius| and |RadiusSpecular| for the native relative tolerance
    if (RadiusSpecular - Radius > Radius * 0.00001f && RadiusSpecular - Radius > -Radius * 0.00001f) || (RadiusSpecular - Radius < Radius * 0.00001f && RadiusSpecular - Radius < -Radius * 0.00001f)
      if (RadiusSpecular - Radius > RadiusSpecular * 0.00001f && RadiusSpecular - Radius > -RadiusSpecular * 0.00001f) || (RadiusSpecular - Radius < RadiusSpecular * 0.00001f && RadiusSpecular - Radius < -RadiusSpecular * 0.00001f)
        Flags = Flags | 1
  if Attenuation1 > -0.5f
    AttHTnLR = Radius * Attenuation1
    AttHTnLR2 = Attenuation2 * Radius * Radius

