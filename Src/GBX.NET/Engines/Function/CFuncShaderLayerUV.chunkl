CFuncShaderLayerUV 0x05015000
- inherits: CFuncShader

property bool EnablePingPong
  get = (Flags & 1) != 0
  set
    if value
      Flags = Flags | 1
    else
      Flags = Flags & 0xFE

property bool EnableSmooth
  get = (Flags & 2) != 0
  set
    if value
      Flags = Flags | 2
    else
      Flags = Flags & 0xFD

property bool WriteX
  get = (WriteFlags & 1) != 0
  set
    if value
      WriteFlags = WriteFlags | 1
    else
      WriteFlags = WriteFlags & 0xFFFFFFFE

property bool WriteY
  get = (WriteFlags & 2) != 0
  set
    if value
      WriteFlags = WriteFlags | 2
    else
      WriteFlags = WriteFlags & 0xFFFFFFFD

property bool WriteZ
  get = (WriteFlags & 4) != 0
  set
    if value
      WriteFlags = WriteFlags | 4
    else
      WriteFlags = WriteFlags & 0xFFFFFFFB

property bool WriteW
  get = (WriteFlags & 8) != 0
  set
    if value
      WriteFlags = WriteFlags | 8
    else
      WriteFlags = WriteFlags & 0xFFFFFFF7

