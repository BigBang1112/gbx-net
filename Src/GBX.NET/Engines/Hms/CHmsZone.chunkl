CHmsZone 0x06004000
- inherits: CMwNod

property bool FogByVertex
  get = (FogFlags & 1) != 0
  set
    if value
      FogFlags = FogFlags | 1
    else
      FogFlags = FogFlags & 0xFFFFFFFE

0x002 [TM10, TMPU, TMSX, TMNESWC, VSK5, TMF, MP3, TMT, MP4, TM2020] // GxFogGlobal::ArchiveFog writes 28 raw bytes and clears nonpersistent flag bits.
  CHmsFogPlane[] FogPlanes (deprec)
  vec3 FogRGB = (1, 1, 1) // sRGB, verified by FogSetColorLinear converting into this field.
  float FogLinearStart
  float FogLinearEnd = 1
  float FogExpDensity = 1
  uint FogFlags = 6 (write: "FogFlags & 0xF") // Bit 0: FogByVertex; bits 1-2: FogFormula; bit 3: FogSpace.
  FogFlags = FogFlags & 0xF

0x003 [TM10, TMPU, TMSX, TMNESWC, VSK5, TMF, MP3, TMT, MP4, TM2020]
  bool MRIsForced
  if MRIsForced
    vec3 MRPoint
    vec3 MRNormal

0x005 [TM10, TMPU, TMSX, TMNESWC, VSK5, TMF, MP3, TMT, MP4, TM2020]
  CHmsPrecalcRender[] PrecalcRenders (deprec)

0x006 [VSK5, TMF]
  CPlugBitmap BitmapCubeReflectHardSpecA (external)

0x008 [MP3, TMT, MP4, TM2020]
  CPlugBitmap BitmapCubeReflectHardSpecA (external)
  CPlugBitmap BitmapCubeReflectHdrAlpha2 (external)

enum EGxFogFormula
  None
  Exp
  Exp2
  Linear

enum EGxFogSpace
  CameraFarZ
  World
