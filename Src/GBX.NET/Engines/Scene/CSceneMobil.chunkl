- inherits: CSceneObject

0x003 [TM10, TMPU, TMSX, TMNESWC, TMU, VSK5, TMF, MP3, TMT, MP4, TM2020]
  CSceneObjectLink[] ObjectLink

0x004 [TM10, TMPU, TMSX, TMNESWC]
