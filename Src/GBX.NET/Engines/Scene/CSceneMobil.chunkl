archive MobilPtr
  CSceneMobil Model
  if Model != null
    int DataVersion = 2
    if DataVersion == 2
      int = -1 // class data terminator
    id Name
    if DataVersion >= 1
      CSceneObjectLink[] ObjectLinks
    if DataVersion < 2 && IsContainerModel
      int LegacyContainerDataVersion = 1 // legacy container instance data, only empty records are supported
      int LegacyContainerDataCount
      if IsMenuFrameModel
        int LegacyMenuFrameDataVersion = 1
        CMwCmdBlockMain OnBeforeShowScript
        CMwCmdBlockMain OnShowScript
        CMwCmdBlockMain OnHideScript
        if LegacyMenuFrameDataVersion >= 1
          id
  else
    CSceneMobil Mobil
