CControlBase 0x07001000
- inherits: CSceneToy

0x00C [TM10, TMPU, TMSX, TMNESWC, TMU, VSK5, TMF, MP3, TMT, MP4, TM2020]
  datauint ControlFlags
  CControlStyle LegacyStyle
  CMwNod
  if n.HasControlStack
    CMwNod Nod
    string StackText

0x00E [TM10, TMPU, TMSX, TMNESWC, TMU, VSK5, TMF, MP3, TMT, MP4, TM2020]
  boxaligned
  CControlLayout Layout
  int
  int

0x00F [TMSX, TMNESWC, TMU, VSK5, TMF, MP3, TMT, MP4, TM2020]
  string

0x010 [TMSX, TMNESWC, TMU, VSK5, TMF, MP3, TMT, MP4, TM2020]
  id StyleId
  if StyleId == ""
    CControlStyle Style
