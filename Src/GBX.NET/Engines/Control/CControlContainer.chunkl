CControlContainer 0x07002000
- inherits: CControlBase

0x005 [TM10, TMPU, TMSX, TMNESWC, TMU, VSK5, TMF, MP3, TMT, MP4, TM2020]
  bool AcceptOwnControls
  bool UseScript
  CMwCmdBlockMain CreateScript
  if !AcceptOwnControls
    int
    Child[] Childs = empty

0x006 [TMT, MP4, TM2020]
  version
  bool IsClippingContainer

archive Child (contextual)
  ModelInstance Instance
  if n.HasMenuFrameChildVersion
    int MenuFrameVersion
  if n.HasFrameChildLocations
    int FrameVersion = 1
  if n.HasGridChildLocations
    int GridVersion = 1
  version = 3
  v1= (archive)
    CControlBase Control
  v2= (archive)
    throw (type: NotSupportedException, message: Unsupported legacy control model)
  v3+ (archive)
    int Index = -2
    if Index == -2
      CControlBase Control
  if n.HasFrameChildLocations
    iso4 RelativeLocation
  if n.HasGridChildLocations
    vec2 Square
    if GridVersion >= 1
      float SquareZ

archive ModelInstance
  CControlBase Model
  InstanceData Data

archive InstanceData
  version = 2
  OwnDataRecord[] OwnDataRecords
  id Name
  CMwNod[] Links
  int ContainerVersion = 3
  Anchor[] Anchors
  TerminalDataRecord[] TerminalData
  CGameMenuFrame.MenuFrameInstanceData MenuFrameData

archive OwnDataRecord
  datauint ClassId
  int Version
  CGameControlCardGeneric.LocalData Data

archive Anchor
  id Name
  int Version
  Child[] Childs (version: 0)

archive TerminalDataRecord
  id Name
  byte Version
  data Data
