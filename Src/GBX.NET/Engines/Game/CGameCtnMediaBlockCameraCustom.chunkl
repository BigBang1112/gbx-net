CGameCtnMediaBlockCameraCustom 0x030A2000 // MediaTracker block - Custom camera.
- inherits: CGameCtnMediaBlockCamera

0x000
  Key[] Keys (version: 0, list)

0x001
  Key[] Keys (version: 1, list)

0x002 [TMSX, TMNESWC, VSK5]
  Key[] Keys (version: 2, list)

0x003
  Key[] Keys (version: 3, list)
  int

0x004
  Key[] Keys (version: 4, list)

0x005 [TMF] // TMUF
  Key[] Keys (version: 5, list)

0x006 [TMT, MP4, TM2020.v4] // ManiaPlanet
  version
  Key[] Keys (version: 6 + Version, list)

enum Interpolation
  None
  Hermite
  Linear
  FixedTangent

archive Key (inherits: IKey)
  float Time (time)
  int<Interpolation> Interpolation
  v5-
    int?
    int?
    vec3 Position
    vec3 PitchYawRoll // Pitch, yaw and roll in radians.
    float Fov
  bool AnchorRot
  v4=
    id AnchorId
  v3-
    int Anchor
  v5+
    int Anchor // -1 or entity number (SGameClipEntityId).
  bool AnchorVis
  v4=
    id TargetId
  v3-
    int Target
  v5+
    int Target // -1 or entity number (SGameClipEntityId).
  v5-
    vec3 TargetPosition
    v1=
      float?
      float?
      return
    v2+
      InterpVal? LeftTangent
      InterpVal? RightTangent
    v3=
      float?
      quat?
  v6+
    vec3 Position
    vec3 PitchYawRoll
    float Fov
    vec3 TargetPosition
    v7+
      float? NearZ
    v10+
      float? PssmDistScale = 1 // Shadow distance scale.
    InterpVal? LeftTangent
    InterpVal? RightTangent
    v8=
      int? LegacyTargetSceneUId // Converted to a clip entity ID on load.
      int? LegacyAnchorSceneUId // Converted to a clip entity ID on load.

archive InterpVal
  vec3 Position
  v5-
    return
  vec3? PitchYawRoll
  float? Fov
  vec3? TargetPosition
  v7+
    float? NearZ
  v10+
    float? PssmDistScale = 1 // Shadow distance scale tangent.
