archive BlockSpawn
  version
  ident BlockModel
  v1- (archive)
    int3 Coord
    int<Direction> Direction
    int MobilIndex
    int MobilVariantIndex
    bool IsGround
    v1+ (archive)
      int BlockInfoVariantIndex
  v2+ (archive)
    v4- (archive)
      byte3 Coord
      byte<Direction> Direction
    int Flags
    v3+ (archive)
      v5+ (archive)
        if ((Flags >> 26) & 1) != 0
          vec3 AbsolutePositionInMap
          vec3 YawPitchRoll
        if ((Flags >> 26) & 1) == 0
          byte3 Coord
          byte<Direction> Direction
      CGameWaypointSpecialProperty Waypoint
      v4+ (archive)
        v5- (archive)
          CGameCtnChallenge Challenge
        v7+ (archive)
          byte Color
        v8+ (archive)
          byte LightmapQuality

