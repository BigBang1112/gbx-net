archive SBakedClipsAdditionalData
  ident Clip1
  ident Clip2
  ident Clip3
  ident Clip4
  int3 Coord

archive SChallengeCardEventIds
  int
  id
  ident[]

enum MapKind // The map's intended use.
  EndMarker
  Campaign
  Puzzle
  Retro
  TimeAttack
  Rounds
  InProgress
  Campaign_7
  Multi
  Solo
  Site
  SoloNadeo
  MultiNadeo

enum PlayMode // Map type in which the map was validated in.
  Race
  Platform
  Puzzle
  Crazy
  Shortcut
  Stunts
  Script // Any custom map type script.

enum EditorMode
  Advanced
  Simple
  HasGhostBlocks
  Gamepad = 4

enum PaletteColor
  Classic
  Stunt
  Red
  Orange
  Yellow
  Lime
  Green
  Cyan
  Blue
  Purple
  Pink
  White
  Black
