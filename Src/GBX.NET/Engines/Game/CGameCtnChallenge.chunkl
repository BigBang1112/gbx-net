property string MapUid
  get = MapInfo.Id

property id? Collection
  get = MapInfo.Collection

property string AuthorLogin
  get = MapInfo.Author

property int? NbBlocks
  get = Blocks.Count

property int? NbBakedBlocks
  get = BakedBlocks.Count

archive WorldDistortBitmapData
  v1=
    WorldDistortTga Tga
  v2+
    int2 Size
    if Size.X < 0 || Size.Y < 0
      throw (type: InvalidDataException, message: Negative world distortion bitmap size)
    if Size.X > 0 && Size.Y > 268435455 / Size.X
      throw (type: InvalidDataException, message: World distortion bitmap is too large)
    data[Size.X * Size.Y * 8] Pixels // RGBA16 pixels, eight bytes per pixel, without a length prefix.

archive WorldDistortTga
  byte ImageIdLength (local, write: "ImageId?.Length ?? 0")
  byte ColorMapType
  byte ImageType
  ushort ColorMapFirstIndex
  ushort ColorMapLength
  byte ColorMapEntrySize
  ushort XOrigin
  ushort YOrigin
  ushort Width
  ushort Height
  byte PixelDepth
  byte ImageDescriptor
  data[ImageIdLength] ImageId
  data EncodedPixels // Self-delimiting pixel packets; custom serialization handles RLE without a length prefix.

archive SubMapSectorGridData
  byte Format // Format 1 omits the grid; other formats store raw byte indices.
  if Format != 1
    data Indices // Sector index at X * Size.Z + Z; 255 means no sector.

archive SubMapSector
  string MapFilePath = empty
  CGameCtnChallenge Map
  int GroundHeight = -1 // Height in block coordinates.
  vec3 Position // Position in the parent map.
  vec3 Pivot // Point in the submap placed at Position.
  float Yaw // Rotation around the Y axis in degrees.

archive SpectatorData
  int U01 // Nonzero enables the editor's "has spectators" indicator.
  int[] U02
  data U03
  v1+
    int U04

archive BlockOctreeData
  int RootNodeSize
  int3 Size
  BlockOctreeNode[] Nodes

archive BlockOctreeNode
  int ParentIndex // BlockOctreeData selects node form: 0 for branches, 1 for current leaves, 2 for legacy leaves.
  v0=
    int[8] Children
  v1+
    byte Value
  v2=
    int LegacyValue

archive MacroblockData
  version = 1
  CGameCtnMacroBlockInfo.BlockSpawn[] Blocks
  CGameCtnMacroBlockInfo.BlockSkinSpawn[] Skins
  CGameCtnMacroBlockInfo.ObjectSpawn[] Items
  v0= (archive)
    uint128[]
  MacroblockReferences BlockReferences

archive MacroblockReferences
  version
  int
  CMwNod[] Nodes

archive RecordedBotPath
  v0+
    int BotPathIndex
  vec3[] Path
  v4-
    uint[] Times
  v3+
    quat[] Rotations
  v4+
    ident Model

archive SubMapInfo
  int BlockIndex // Index in the map's serialized block list.
  int U01
  string SubMapDataRefForEditor = empty
  v1+
    CGameCtnChallenge SubMapNod

archive BotPath
  int Clan
  vec3[] Path (list)
  bool IsFlying
  CGameWaypointSpecialProperty WaypointSpecialProperty
  bool IsAutonomous

archive SBakedClipsAdditionalData
  ident Clip1
  ident Clip2
  ident Clip3
  ident Clip4
  int3 Coord

archive SChallengeCardEventIds
  int
  id
  ident[]

enum MapKind // The map's intended use.
  EndMarker
  Campaign
  Puzzle
  Retro
  TimeAttack
  Rounds
  InProgress
  Campaign_7
  Multi
  Solo
  Site
  SoloNadeo
  MultiNadeo

enum PlayMode // Map type in which the map was validated in.
  Race
  Platform
  Puzzle
  Crazy
  Shortcut
  Stunts
  Script // Any custom map type script.

enum EditorMode
  Advanced
  Simple
  HasGhostBlocks
  Gamepad = 4

enum PaletteColor
  Classic
  Stunt
  Red
  Orange
  Yellow
  Lime
  Green
  Cyan
  Blue
  Purple
  Pink
  White
  Black
