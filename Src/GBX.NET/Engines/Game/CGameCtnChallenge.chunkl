0x058 (skippable) [MP4.v1] // SubMapsInfos
  version
  int SubMapCount (local, write: "n.SubMapsInfos?.Length ?? 0")
  if SubMapCount < 0
    throw (type: InvalidDataException, message: Negative submap count)
  if Version >= 1 && SubMapCount >= 1
    block (encapsulated)
      SubMapInfo[SubMapCount] SubMapsInfos (version: Version)
  else
    SubMapInfo[SubMapCount] SubMapsInfos (version: Version)

0x059 (skippable) [MP4.v2, TM2020.v3] // world distortion
  version
  vec3 WorldDistortScales
  v0=
    CPlugBitmap WorldDistortBitmap // World distortion XYZ bitmap. Crashes ManiaPlanet if set (dead code).
  v1+
    bool HasWorldDistortXYZ (local, write: "n.WorldDistortXYZ is not null")
    if HasWorldDistortXYZ
      if Version >= 3
        throw (type: NotSupportedException, message: World distortion bitmaps are unsupported in chunk version 3)
      WorldDistortBitmapData WorldDistortXYZ (version: Version) // World distortion XYZ bitmap data. Crashes ManiaPlanet if set (dead code).
    else
      WorldDistortXYZ = null
    v3+
      int // Discarded
      int // Discarded

0x05A (skippable) [TM2020] // submap sectors
  version
  int SubMapSectorCount (local, write: "n.SubMapSectors?.Length ?? 0")
  if SubMapSectorCount < 0
    throw (type: InvalidDataException, message: Negative submap sector count)
  if SubMapSectorCount >= 1
    block (encapsulated)
      SubMapSectorGridData SubMapSectorGrid
      SubMapSector[SubMapSectorCount] SubMapSectors
  else
    SubMapSector[0] SubMapSectors
    SubMapSectorGrid = null

