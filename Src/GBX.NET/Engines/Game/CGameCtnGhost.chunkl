CGameCtnGhost 0x03092000 // A ghost.
- inherits: CGameGhost

0x000 (skippable) [TMT.v2, MP4.v2, TM2020.v9]
  version
  v9+
    int AppearanceVersion
  ident PlayerModel
  vec3 LightTrailColor
  packdesc[] SkinPackDescs (list)
  bool HasBadges
  if HasBadges
    SBadge Badge
  if AppearanceVersion >= 1
    string SkinCustomization
  string GhostNickname (formatted)
  string GhostAvatarName
  v2+
    string RecordingContext
    v4+
      int = 2
      v5+
        CPlugEntRecordData RecordData
        int[]
        v6+
          string GhostTrigram
          v7+
            string GhostCountryPath
            v8+
              string GhostClubTag (formatted)

0x003 [TM10, TMPU]
  ident PlayerModel
  string SkinFile
  string GhostNickname (formatted)

0x004 (skippable) [TMPU] // checkpoints TMPU
  Checkpoint[] Checkpoints

0x005 (skippable) [TMPU, TMS, TMSX, TMNESWC, TMU, VSK5, TMF, MP3, TMT, MP4, TM2020] // race time
  int? RaceTime (time)

0x006 [TMS, TMSX, TMNESWC]
  ident PlayerModel
  string SkinFile
  int
  string GhostNickname (formatted)

0x007 // old light trail color
  vec3 LightTrailColor

0x008 (skippable) [TMS, TMSX, TMNESWC, TMU, VSK5, TMF, MP3, TMT, MP4, TM2020] // respawns
  int? Respawns

0x009 (skippable) [TMS, TMSX, TMNESWC, TMU, VSK5, TMF, MP3] // light trail color
  vec3 LightTrailColor

0x00A (skippable) [TMSX, TMNESWC, TMU, VSK5, TMF, MP3, TMT, MP4, TM2020] // stunt score
  int? StuntScore

0x00B (skippable) [TMSX, TMNESWC, TMU, VSK5, TMF, MP3, TMT, MP4, TM2020] // checkpoint times
  Checkpoint[] Checkpoints (version: 1)

0x00C [TMNESWC, TMU, VSK5, TMF, MP3, TMT, MP4, TM2020]
  int

0x00D [TMU, VSK5]
  ident PlayerModel
  string SkinFile
  int
  int
  int
  int
  string GhostNickname (formatted)

0x00E [TMU, VSK5, TMF, MP3, TMT, MP4, TM2020] // GhostUid
  id? GhostUid

0x00F [TMU, VSK5, TMF, MP3, TMT, MP4, TM2020] // ghost login
  string GhostLogin

0x010 [TMU, VSK5, TMF, MP3, TMT, MP4, TM2020] // validation map UID
  id Validate_ChallengeUid

0x011 (demonstration: partial) [TMU, VSK5] // validation TMU
  int EventsDuration (time)
  if EventsDuration != 0
    // CInputEventsStore is handled in C# before the validation fields.
    string Validate_ExeVersion
    uint Validate_ExeChecksum
    int Validate_OsKind
    int Validate_CpuKind
    string Validate_RaceSettings

0x012 [TMU, VSK5, TMF] // old security key
  uint
  uint128? SecurityKey128

0x013 (skippable) [TMF, MP3, TMT, MP4, TM2020]
  int
  int

0x014 (skippable) [TMF, MP3, TMT, MP4, TM2020] // ghost version
  int? GhostVersion

0x015 [TMF] // ghost nickname
  id GhostNickname (formatted)

0x017 (skippable) [TMF, MP3] // ghost metadata
  packdesc[] SkinPackDescs (list)
  string GhostNickname (formatted)
  string GhostAvatarName

0x018 [TMF, MP3] // PlayerModel TMF-MP3
  ident PlayerModel

0x019 (base: 0x011) [TMF] // validation TMUF
  base
  if EventsDuration != 0
    int? Validate_ValidationSeed

0x01A (skippable) [MP3, TMT, MP4, TM2020] // checkpoint count

0x01B (skippable, demonstration: partial) [MP3, TMT, MP4, TM2020] // race result
  version = 2
  // RaceTime, StuntScore, Respawns and checkpoint times are handled in C#.
  // v0 uses raw times, v1 uses reverse deltas, v2 uses forward deltas.
  v2=
    int? RaceStartTime (time)

0x01C [MP3, TMT, MP4, TM2020] // security key
  uint256? SecurityKey256

0x01D (skippable) [MP3.v3, TMT.v3, MP4.v3, TM2020.v4] // player input data
  version
  PlayerInputData[] PlayerInputs

0x01F (skippable, ignore) // OldColorHistory

0x021 (skippable, ignore) // OldKeyStrokes

0x022 (skippable) [MP3, TMT, MP4, TM2020] // settings info
  version
  v1-
    OldSettingsInfos[] OldSettings
  v2+
    SettingsInfos[] Settings

0x023 (skippable) [MP3, TMT, MP4, TM2020] // anticheat system info
  version
  string CpuDescription
  int CpuKind
  string GpuDescription
  int GpuDeviceId
  int GpuVendorId
  string HardwareUid
  ipv4 NetworkAddress
  string LoggedUserName
  v2+
    byte GpuCount
    int
    int
    v3+
      byte HasHmd
      byte

0x024 (skippable) [MP3, TMT, MP4, TM2020] // match replay separators
  version
  MatchReplaySeparator[] MatchReplaySeparators

0x025 (skippable, demonstration: partial) [MP3.v0, TMT.v0, MP4.v0, TM2020.v1] // validation TM2
  version
  int EventsDuration (time)
  v0-
    if EventsDuration == 0
      return
  // CInputEventsStore is handled in C# before the validation fields.
  string Validate_ExeVersion
  uint Validate_ExeChecksum
  int Validate_OsKind
  int Validate_CpuKind
  string Validate_RaceSettings
  int? Validate_ValidationSeed
  bool SteeringWheelSensitivity

0x026 (skippable) [MP3, TMT, MP4, TM2020] // GhostUid128
  checksum128? GhostUid128

0x027 (skippable) [MP3, TMT, MP4, TM2020] // screen captures
  version
  CPlugTimedPixelArray[] ScreenCaptures
  v1+
    int[] ScreenCaptureKeyframeIndices
    v3+
      CPlugTimedPixelArray[] ScreenCaptures_Difference

0x028 (skippable) [MP4, TM2020] // title id
  if EventsDuration != 0
    string Validate_TitleId
    checksum256? Validate_TitleChecksum

0x029 (skippable) [TM2020.v1] // record context
  version
  int<ScopeType> Validate_ScopeType
  string Validate_ScopeId
  string Validate_GameMode
  string Validate_GameModeCustomData

0x02A (skippable) [TM2020] // validation game rules and race start time
  int Validate_GameRules = 1 // packed gameplay settings, also serialized in 0x02D
  int? Validate_RaceStartTime (time) // simulation time, also serialized in 0x02D

0x02B (skippable) [TM2020.v1] // race result TM2020
  version
  v2+
    return
  int? RaceTime (time)
  int? StuntScore
  int? Respawns
  int? SpawnLandmarkId = -1 // extra race-result field
  Checkpoint[] Checkpoints (version: 2)
  int? RaceStartTime (time)

0x02C (skippable) [TM2020]
  version
  unixtime? WalltimeStartTimestamp
  unixtime? WalltimeEndTimestamp

0x02D (skippable, demonstration: partial) [TM2020]
  // HasInputs and the optional CInputEventsStore are handled in C#.
  string Validate_ExeVersion
  uint Validate_ExeChecksum
  int Validate_OsKind
  int Validate_CpuKind
  unixtime? WalltimeStartTimestamp
  unixtime? WalltimeEndTimestamp
  string Validate_TitleId
  checksum256? Validate_TitleChecksum
  int Validate_GameRules
  int? Validate_RaceStartTime (time)
  int? Validate_ValidationSeed
  // SimulationFlags is handled in C#.
  string Validate_RaceSettings // native m_ValidationData.ExtraTool_Info in TM2020

0x02E (skippable) [TM2020]
  string SkinCustomization

0x0304F001 (skippable, ignore, not-remapped) [TMF] // TMCP

property TimeSpan? WalltimeDuration
  get = WalltimeEndTimestamp - WalltimeStartTimestamp

archive PlayerInputData
  int<EVersion> Version // 8 in ShootMania, 12 in TM2020
  int
  v4+ // chunk version, NOT archive version
    int? StartOffset (time)
  int Ticks
  data Data

archive SBadge
  version
  vec3 Color
  v0= (archive)
    int
    string
  SSticker[] Stickers (version: v, list)
  string[] Layers (list)

archive SSticker
  string
  string

archive Checkpoint
  int? Time (time)
  v0=
    float? Speed
  v1=
    int? StuntsScore
  v2=
    int? CheckpointId // inferred from recorded checkpoint identifiers

archive OldSettingsInfos
  int
  int
  int

archive SettingsInfos
  bool
  bool
  byte
  bool MouseAccelEnabled
  float MouseAccelQuantity
  bool MouseSensitivitiesEnableSpecific
  float MouseScaleY
  float[] MouseSensitivities // default and laser sensitivities
  string U09
  v3+
    int ScreenWidth
    int ScreenHeight
    int Time (time)
    v4+
      float MouseScaleFreeLook

archive MatchReplaySeparator
  int
  int

enum ScopeType
  Unknown = -1
  PersonalBest
  Season
