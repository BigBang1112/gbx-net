CGameUserFileList 0x031B7000

0x000 [TMT, MP4.v1]
  version = 1
  FileInfo[] Files

archive FileInfo
  string Name = empty
  byte // Name terminator
  filetime? FileWriteTime
  ulong FileSize
  int<FileType> Type
  switch Type
    case FileType.Map
      id MapUid = empty
      string? MapName
      byte // MapName terminator
    case FileType.Ghost
      string? RecordingContext
      byte // RecordingContext terminator
      id MapUid = empty
      int? RaceTime (time)
    default
      throw (type: ThisShouldNotHappenException)

enum FileType
  Map
  Ghost
