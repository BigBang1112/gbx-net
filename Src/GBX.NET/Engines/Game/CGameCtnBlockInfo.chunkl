enum EWayPointType
  Start
  Finish
  Checkpoint
  None
  StartFinish
  Dispenser

enum EMultiDir
  SameDir
  SymmetricalDirs
  AllDir
  OpposedDirOnly
  PerpendicularDirsOnly
  NextDirOnly
  PreviousDirOnly

enum ESelection
  Random
  Medpi = 1 // Weighted mobil selection, with at least eight mobils, the first four receive 75% of selections
  Obsolete = 1 // Compatibility alias for Medpi
  AutoRotate = 2

enum EBaseType
  None
  Conductor
  Generator
  Collector
