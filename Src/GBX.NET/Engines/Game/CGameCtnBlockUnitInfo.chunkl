CGameCtnBlockUnitInfo 0x03036000

0x000 [TM10, TMPU, TMSX, TMNESWC, TMU, VSK5, TMF, MP3, TMT, MP4, TM2020]
  int PlacePylons
  bool // AcceptPylons? true = 255, false = 0?
  bool
  int3 RelativeOffset
  CGameCtnBlockInfoClip[] Clips // also called Junctions

0x001 [TM10, TMPU, TMSX, TMNESWC, TMU, VSK5, TMF, MP3, TMT, MP4, TM2020]
  id Surface
  int Frontier
  int<Direction> Dir

0x002 (skippable) [TMPU, TMSX, TMNESWC, TMU, VSK5, TMF, MP3, TMT, MP4, TM2020] // Underground
  bool Underground

0x003 [TMSX, TMNESWC, TMU, VSK5, TMF]
  CGameCtnBlockInfo ReplacementBlockInfo
  id ReplacementId
  int<ReplacementDir> MultiDir
  int

0x004 [TMNESWC, TMU, VSK5, TMF, MP3, TMT, MP4, TM2020] // AcceptPylons
  int AcceptPylons

0x005 [TMU, VSK5, TMF, MP3, TMT, MP4, TM2020] // TerrainModifierId
  id TerrainModifierId

0x006 [MP3, TMT, MP4]
  bool
  bool
  int
  bool
  int
  bool
  int
  bool
  int

0x007 [MP3, TMT, MP4, TM2020]
  CGameCtnBlockInfoPylon PylonNorth
  CGameCtnBlockInfoPylon PylonEast
  CGameCtnBlockInfoPylon PylonSouth
  CGameCtnBlockInfoPylon PylonWest

0x008 // bottom+top clip
  CGameCtnBlockInfoClip BottomClip
  CGameCtnBlockInfoClip TopClip

0x009 [MP3, TMT]
  version
  CMwNod // pillar stuff?
  int
  v0=
    int
  v2=
    byte

0x00A [MP3, TMT]
  version
  CMwNod // pillar stuff?
  int

0x00B [MP3, TMT, MP4] // bottom+top clip with dir
  version
  CGameCtnBlockInfoClip BottomClip
  CGameCtnBlockInfoClip TopClip
  int<Direction>? BottomClipDir
  int<Direction>? TopClipDir

0x00C [TM2020.v2]
  version (write: "ValidateClipCounts(n)")
  v0=
    ushort ClipCountBits (local, write: "(ushort)((ClipsNorth?.Count ?? 0) | (ClipsEast?.Count ?? 0) << 2 | (ClipsSouth?.Count ?? 0) << 4 | (ClipsWest?.Count ?? 0) << 6 | (ClipsTop?.Count ?? 0) << 8 | (ClipsBottom?.Count ?? 0) << 10)") // Six 2-bit counts: north, east, south, west, top, bottom.
    CGameCtnBlockInfoClip[ClipCountBits & 3] ClipsNorth
    CGameCtnBlockInfoClip[(ClipCountBits >> 2) & 3] ClipsEast
    CGameCtnBlockInfoClip[(ClipCountBits >> 4) & 3] ClipsSouth
    CGameCtnBlockInfoClip[(ClipCountBits >> 6) & 3] ClipsWest
    CGameCtnBlockInfoClip[(ClipCountBits >> 8) & 3] ClipsTop
    CGameCtnBlockInfoClip[(ClipCountBits >> 10) & 3] ClipsBottom
  v1+
    int ClipCountBits (local, write: "(ClipsNorth?.Count ?? 0) | (ClipsEast?.Count ?? 0) << 3 | (ClipsSouth?.Count ?? 0) << 6 | (ClipsWest?.Count ?? 0) << 9 | (ClipsTop?.Count ?? 0) << 12 | (ClipsBottom?.Count ?? 0) << 15") // Six 3-bit counts in the same order.
    CGameCtnBlockInfoClip[ClipCountBits & 7] ClipsNorth
    CGameCtnBlockInfoClip[(ClipCountBits >> 3) & 7] ClipsEast
    CGameCtnBlockInfoClip[(ClipCountBits >> 6) & 7] ClipsSouth
    CGameCtnBlockInfoClip[(ClipCountBits >> 9) & 7] ClipsWest
    CGameCtnBlockInfoClip[(ClipCountBits >> 12) & 7] ClipsTop
    CGameCtnBlockInfoClip[(ClipCountBits >> 15) & 7] ClipsBottom
  v2+
    short?
    short?
  v1-
    int?
    int?

0x00D [TM2020]
  version
  data

enum EFrontier
  DeadEnd
  Corner
  Straight
  TShaped
  Cross

enum ReplacementDir
  Simple
  Symetrical
  All
