<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <PackageId>GBX.NET</PackageId>
        <VersionPrefix>2.5.2</VersionPrefix>
        <Authors>BigBang1112</Authors>
        <Description>General purpose library for Gbx files - data from Nadeo games like Trackmania or Shootmania. It supports high performance serialization and deserialization of 500+ Gbx classes.</Description>
        <Copyright>Copyright (c) 2026 Petr Pivoňka</Copyright>
        <PackageProjectUrl>https://github.com/BigBang1112/gbx-net</PackageProjectUrl>
        <PackageIcon>logo_icon_outline.png</PackageIcon>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageTags>gbx, trackmania, shootmania, maniaplanet, gamebox, net, chunk, file</PackageTags>
        <PackageReleaseNotes>
- Added support for `CSceneVehicleCar` ghost sample versions 2 and 6
- Added `CGameCtnGhost.GetSimulationInputs()` for replaying Competition Patch 2 (by Tomashu)
- Deprecated `CGameCtnGhost.GetDisplayableInputs()` in favor of `GetDisplayInputs()`
- Added Always Official ghost metadata, including race start and finish timestamps
- Added `NodeRef.SetFile()` to assign an external file reference without loading it
- Added `INodeRefList.EnumerateReferences()` to inspect stored references without resolving them
- Fixed class ID remapping for older games
- Fixed map round-trips that lost `SnappedOnBlock` links
- `CGameCtnChallenge`: Added `BlockArchiveVersion` and `BakedBlockArchiveVersion`
  - `Chunk0304301F.Version` was removed.
- `CGameCtnBlock`: Added `BlockInfoVariantIndex` and `IsEditable`
  - Use them in place of `Bit21` and `IsClip`
- Changed `NPlugItem_SVariant.Tags` to `List&lt;KeyValuePair&lt;string, string&gt;&gt;` to preserve tag order and duplicate keys
- Fixed `CGameCtnCollector.CatalogPosition` and `NbAvailableMax` for values above 32767
- Fixed serialization of official campaign paths in `CGameCtnApp`, `CFuncEnvelope.KeyFramePos2`, `CPlugShaderPass.PipelineGpu.HasExternalFile`, and numeric-looking IDs in `CPlugTree`
- Updated to .NET 11
        </PackageReleaseNotes>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
    </PropertyGroup>

    <PropertyGroup>
        <TargetFrameworks>net11.0;net10.0;net9.0;net8.0;netstandard2.0</TargetFrameworks>
        <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
        <CompilerGeneratedFilesOutputPath>$(MSBuildProjectDirectory)\Generated\$(TargetFramework)</CompilerGeneratedFilesOutputPath>
        <LangVersion>15</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsTrimmable Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net6.0'))">true</IsTrimmable>
        <IsAotCompatible Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net7.0'))">true</IsAotCompatible>

        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>

        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>

        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <DocumentationFile>bin\$(Configuration)\$(TargetFramework)\$(AssemblyName).xml</DocumentationFile>
        <NoWarn>1591</NoWarn>
    </PropertyGroup>
    
    <ItemGroup>
        <SupportedPlatform Include="browser" />
    </ItemGroup>

    <ItemGroup>
        <None Include="../../Media/logo_icon_outline.png" Pack="true" PackagePath="\" />
        <None Include="README.md" Pack="true" PackagePath="\" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.15" />
        <PackageReference Include="System.IO.Hashing" Version="10.0.15" />
        <PackageReference Include="TmEssentials" Version="2.9.1" />
        <PackageReference Include="Zomp.SyncMethodGenerator" Version="2.0.66">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
        <PackageReference Include="System.Memory" Version="4.6.3" />
        <PackageReference Include="System.Collections.Immutable" Version="11.0.0" />
        <PackageReference Include="System.Threading.Tasks.Extensions" Version="4.6.3" />
    </ItemGroup>

    <Import Project="GBX.NET.Usings.props" />

    <ItemGroup>
        <AdditionalFiles Include="Engines/*/*.chunkl" />
    </ItemGroup>

    <ItemGroup>
        <AdditionalFiles Include="../../Resources/ClassId.txt" />
        <AdditionalFiles Include="../../Resources/ClassIdManual.txt" />
        <AdditionalFiles Include="../../Resources/CollectionId.txt" />
        <AdditionalFiles Include="../../Resources/Wrap.txt" />
        <AdditionalFiles Include="../../Resources/ClassIdRemap.txt" />
        <AdditionalFiles Include="../../Resources/Unwrap.txt" />
        <AdditionalFiles Include="../../Resources/Extensions.txt" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="$(AssemblyName).Tests" />
        <InternalsVisibleTo Include="$(AssemblyName).Benchmarks" />
        <InternalsVisibleTo Include="$(AssemblyName).Builders" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\Generators\GBX.NET.Generators\GBX.NET.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    </ItemGroup>

</Project>
