<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <PackageId>GBX.NET</PackageId>
        <VersionPrefix>2.5.2</VersionPrefix>
        <Authors>BigBang1112</Authors>
        <Description>General purpose library for Gbx files - data from Nadeo games like Trackmania or Shootmania. It supports high performance serialization and deserialization of 500+ Gbx classes.</Description>
        <Copyright>Copyright (c) 2026 Petr Pivoňka</Copyright>
        <PackageProjectUrl>https://github.com/BigBang1112/gbx-net</PackageProjectUrl>
        <PackageIcon>logo_icon_outline.png</PackageIcon>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageTags>gbx, trackmania, shootmania, maniaplanet, gamebox, net, chunk, file</PackageTags>
        <PackageReleaseNotes>
- Added signature chunk at the end of written binary bodies
  - Added `GbxBody.Signature` and `Gbx.ValidateSignature(Async)` returning `GbxSignatureStatus`
- Implemented remaining MP4 and TM2020 `CPlugVehicleCarPhyTuning` chunks and discovered many of their member names
- `CPlugVehicleVisModelShared`: Discovered member names of materials, lights, particles, sounds, arms, and wheels
- `CPlugVehicleVisModelShared`: Fixed `0x01F` version 6 and `0x022` versions below 5
- Updated `CPlugMaterial`, `CPlugMaterialCustom`, `CPlugMaterialUserInst`, `CPlugMaterialColorTargetTable`, `CPlugLight`, `CPlugGameSkin`, `CPlugFxWindOnDecal`, and `CPlugTurretObjectParams`, `CGameItemModel`, `CFuncShaderLayerUV`, and `CFuncShaderTweakKeysTranss`
- Resolved few unknowns in `CGamePlayerProfileChunk_AccountSettings`
- `CGameCtnGhost`: Added TM2020 `TICK` chunk
- `GameVersion` now differentiates MP3 and TMT maps, and TMT and MP4 ghosts
- Fixed `GameVersion` in chunk versions and `IsGameVersion(GameVersion.Unspecified)`
- Added missing game version qualifiers to many chunks
- Increased default array, body, and skippable chunk size limits from 256 MB to 512 MB
- Added `MethodAttribute` to link properties to methods
- Removed forgotten `Experimental` attributes on `DeepClone`
        </PackageReleaseNotes>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
    </PropertyGroup>

    <PropertyGroup>
        <TargetFrameworks>net10.0;net9.0;net8.0;netstandard2.0</TargetFrameworks>
        <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
        <CompilerGeneratedFilesOutputPath>$(MSBuildProjectDirectory)\Generated\$(TargetFramework)</CompilerGeneratedFilesOutputPath>
        <LangVersion>14</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsTrimmable Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net6.0'))">true</IsTrimmable>
        <IsAotCompatible Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net7.0'))">true</IsAotCompatible>

        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>

        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>

        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <DocumentationFile>bin\$(Configuration)\$(TargetFramework)\$(AssemblyName).xml</DocumentationFile>
        <NoWarn>1591</NoWarn>
    </PropertyGroup>
    
    <ItemGroup>
        <SupportedPlatform Include="browser" />
    </ItemGroup>

    <ItemGroup>
        <None Include="../../Media/logo_icon_outline.png" Pack="true" PackagePath="\" />
        <None Include="README.md" Pack="true" PackagePath="\" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
        <PackageReference Include="System.IO.Hashing" Version="10.0.12" />
        <PackageReference Include="TmEssentials" Version="2.8.0" />
        <PackageReference Include="Zomp.SyncMethodGenerator" Version="2.0.56">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
        <PackageReference Include="System.Memory" Version="4.6.3" />
        <PackageReference Include="System.Collections.Immutable" Version="10.0.2" />
        <PackageReference Include="System.Threading.Tasks.Extensions" Version="4.6.3" />
    </ItemGroup>

    <Import Project="GBX.NET.Usings.props" />

    <ItemGroup>
        <AdditionalFiles Include="Engines/*/*.chunkl" />
    </ItemGroup>

    <ItemGroup>
        <AdditionalFiles Include="../../Resources/ClassId.txt" />
        <AdditionalFiles Include="../../Resources/ClassIdManual.txt" />
        <AdditionalFiles Include="../../Resources/CollectionId.txt" />
        <AdditionalFiles Include="../../Resources/Wrap.txt" />
        <AdditionalFiles Include="../../Resources/Unwrap.txt" />
        <AdditionalFiles Include="../../Resources/Extensions.txt" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="$(AssemblyName).Tests" />
        <InternalsVisibleTo Include="$(AssemblyName).Benchmarks" />
        <InternalsVisibleTo Include="$(AssemblyName).Builders" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\Generators\GBX.NET.Generators\GBX.NET.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    </ItemGroup>

</Project>
