{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "GbxCLI",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "Build GbxCLI",
      "program": "${workspaceFolder}/Tools/GbxCLI/bin/Debug/net10.0/gbx.dll",
      "args": "${input:gbxCliArgs}",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "stopAtEntry": false
    },
    {
      "name": "Gbx Explorer: Debug (Edge)",
      "type": "blazorwasm",
      "request": "launch",
      "cwd": "${workspaceFolder}/Tools/GbxExplorerOld/Client",
      "browser": "edge"
    },
    {
      "name": "Gbx Explorer: Watch",
      "type": "node-terminal",
      "request": "launch",
      "command": "dotnet watch --launch-profile GbxExplorerOld.Client",
      "cwd": "${workspaceFolder}/Tools/GbxExplorerOld/Client",
      "env": {
        "DOTNET_WATCH_RESTART_ON_RUDE_EDIT": "1"
      }
    },
    {
      "name": "Gbx Explorer: Watch (Integrated Browser)",
      "type": "node-terminal",
      "request": "launch",
      "command": "dotnet watch --launch-profile GbxExplorerOld.Client",
      "cwd": "${workspaceFolder}/Tools/GbxExplorerOld/Client",
      "env": {
        "DOTNET_WATCH_SUPPRESS_LAUNCH_BROWSER": "1",
        "DOTNET_WATCH_RESTART_ON_RUDE_EDIT": "1"
      },
      "serverReadyAction": {
        "action": "openIntegratedBrowser",
        "pattern": "Now listening on:\\s+(https?://\\S+)",
        "uriFormat": "%s"
      }
    }
  ],
  "inputs": [
    {
      "id": "gbxCliArgs",
      "type": "promptString",
      "description": "GbxCLI arguments"
    }
  ]
}
