<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <PublishAot Condition="'$(EnableNativeAOT)' == 'true'">true</PublishAot>
        <InvariantGlobalization Condition="'$(EnableNativeAOT)' == 'true'">true</InvariantGlobalization>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="GBX.NET" Version="2.4.5" />
        <PackageReference Include="GBX.NET.LZO" Version="2.1.4" Condition="'$(EnableLzo)' == 'true'" />
        <PackageReference Include="GBX.NET.ZLib" Version="1.1.2" Condition="'$(EnableZlib)' == 'true'" />
    </ItemGroup>

</Project>
